    <edge source="Quang Trung" target="Nguyễn Huệ">
      <data key="d7">1.0</data>
      <data key="d8">Nguyễn Huệ is the regnal name adopted by Quang Trung during his reign as emperor.</data>
      <data key="d9">regnal_name</data>
      <data key="d10">doc-aa29d86774521f5349a5ac2b6b4e6482-chunk-000</data>
